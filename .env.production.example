# Production template for Orange Hosting (cPanel, no SSH/Git — 1_0.txt §9).
# Copy this to `.env` ON THE SERVER only — never commit a filled-in copy.
# Every <FILL_IN_...> placeholder below must be replaced with a real value
# before go-live; nothing in this file is a working credential.

APP_NAME=Shobley
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<FILL_IN_YOUR_DOMAIN>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<FILL_IN_CPANEL_DB_NAME>
DB_USERNAME=<FILL_IN_CPANEL_DB_USER>
DB_PASSWORD=<FILL_IN_CPANEL_DB_PASSWORD>

# HTTPS-only cookies — only correct once SSL (AutoSSL/Let's Encrypt) is live.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# `log` only writes to storage/logs — pick a real transactional-email
# provider before launch, or order/payment/shipping emails never arrive.
# Postmark and Resend are already wired in config/services.php; set
# MAIL_MAILER to whichever you provision and fill in its section below.
MAIL_MAILER=<FILL_IN_smtp_or_postmark_or_resend>
MAIL_SCHEME=null
MAIL_HOST=<FILL_IN_SMTP_HOST>
MAIL_PORT=587
MAIL_USERNAME=<FILL_IN_SMTP_USERNAME>
MAIL_PASSWORD=<FILL_IN_SMTP_PASSWORD>
MAIL_FROM_ADDRESS="orders@<FILL_IN_YOUR_DOMAIN>"
MAIL_FROM_NAME="${APP_NAME}"
# POSTMARK_API_KEY=
# RESEND_API_KEY=

VITE_APP_NAME="${APP_NAME}"

# ---------- Payments (Stripe — LIVE keys, not test) ----------
STRIPE_KEY=<FILL_IN_pk_live_...>
STRIPE_SECRET=<FILL_IN_sk_live_...>
STRIPE_WEBHOOK_SECRET=<FILL_IN_whsec_..._from_the_live_webhook_endpoint>

# ---------- Vendor Sourcing (Printful) ----------
PRINTFUL_API_KEY=<FILL_IN_OR_LEAVE_BLANK_AND_SET_VIA_ADMIN_GATEWAY_SETTINGS>
PRINTFUL_STORE_ID=<FILL_IN_OR_LEAVE_BLANK_AND_SET_VIA_ADMIN_GATEWAY_SETTINGS>

# ---------- Vendor Sourcing (CJ Dropshipping) ----------
CJ_API_EMAIL=<FILL_IN_OR_LEAVE_BLANK_AND_SET_VIA_ADMIN_GATEWAY_SETTINGS>
CJ_API_KEY=<FILL_IN_OR_LEAVE_BLANK_AND_SET_VIA_ADMIN_GATEWAY_SETTINGS>

# ---------- Marketing Attribution (GA4 / Meta / TikTok) ----------
# Optional at launch — leave blank to ship without server-side marketing
# events; every service here already no-ops safely when unconfigured.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
META_PIXEL_ID=
META_ACCESS_TOKEN=
TIKTOK_PIXEL_CODE=
TIKTOK_ACCESS_TOKEN=
